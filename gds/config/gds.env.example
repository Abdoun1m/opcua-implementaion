GDS_HTTP_PORT=8081
GDS_UVICORN_INTERNAL_PORT=18081
GDS_OPCUA_PLACEHOLDER_PORT=58810
GDS_OPCUA_FACADE_ENABLED=true
GDS_OPCUA_FACADE_HOST=0.0.0.0
GDS_OPCUA_FACADE_PORT=4841
GDS_OPCUA_FACADE_MODE=cyber_range
GDS_OPCUA_FACADE_ALLOW_SIGNING=false
GDS_TLS_PROFILE=lab
GDS_MTLS_MODE=optional
GDS_TLS_SERVER_CERT_FILE=/etc/labshock-gds-tls/server.crt
GDS_TLS_SERVER_KEY_FILE=/etc/labshock-gds-tls/server.key
GDS_TLS_CLIENT_CA_FILE=/etc/labshock-gds-tls/ca.crt
GDS_TLS_CLIENT_CRL_FILE=/etc/labshock-gds-tls/client-ca.crl.pem
GDS_CERT_EXPIRY_WARNING_DAYS=30
GDS_CERT_EXPIRY_CRITICAL_DAYS=7
GDS_VAULT_SIGN_ROLE=opcua-application
GDS_CERT_DEFAULT_TTL=720h
GDS_TRUSTED_PROXY_IPS=127.0.0.1,::1
GDS_INTERNAL_PROXY_SECRET_FILE=/run/secrets/gds-internal-proxy/secret
# Optional fallback when no secret file is mounted. If empty, the entrypoint generates an ephemeral secret.
GDS_INTERNAL_PROXY_SECRET=

GDS__VAULT__ADDR=http://192.168.10.10:8200
GDS__VAULT__ROLE_ID_FILE=/run/secrets/gds_role_id
GDS__VAULT__SECRET_ID_FILE=/run/secrets/gds_secret_id
GDS__VAULT__APPROLE_LOGIN_PATH=/v1/auth/approle/login
GDS__VAULT__TOKEN_LOOKUP_PATH=/v1/auth/token/lookup-self
GDS__VAULT__TOKEN_RENEW_PATH=/v1/auth/token/renew-self
GDS__VAULT__PKI_MOUNT=pki-int
GDS__VAULT__TOKEN_RENEW_MARGIN_SECONDS=300
GDS__VAULT__ALLOW_UNAUTHENTICATED_PKI_READ=false

GDS__DB__HOST=192.168.10.31
GDS__DB__PORT=5432
GDS__DB__NAME=labshock_gds
GDS__DB__USER=gds
GDS_FALLBACK_SHARED_PKI_ROOT=/shared-pki/source/issued
GDS_TRUST_ARTIFACT_SIGNING_KEY_PATH=/var/lib/labshock-gds/signing/trust-artifact-ed25519.pem
GDS_TRUST_ARTIFACT_SIGNING_KEY_ID=gds-trust-artifact-v1
GDS_TRUST_ARTIFACT_TTL_MINUTES=15
GDS_TRUST_ARTIFACT_TTL_SECONDS=900
GDS_TRUST_ARTIFACT_REGEN_THRESHOLD_PCT=20
GDS_TRUST_ARTIFACT_REGEN_THRESHOLD_PERCENT=20
GDS_TRUST_ARTIFACT_SCAN_INTERVAL_SECONDS=30
GDS_TRUST_ARTIFACT_REGEN_MIN_INTERVAL_SECONDS=30
GDS_SIGN_DEBUG=false
GDS_AGENT_AUTH_ENABLED=false
GDS_AGENT_TOKENS_FILE=/etc/labshock-gds-agent-auth/gds-agent-tokens.json
